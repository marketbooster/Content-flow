# ── Mission Control: server-side configuratie. Nooit in de client. ──
# Zonder Supabase-variabelen draait de app in DEMO-modus (lokale opslag in .data/, geen login).

# App
APP_URL=http://localhost:3000
OWNER_EMAIL=                       # het enige e-mailadres dat mag inloggen (magic link)
CRON_SECRET=                       # lange willekeurige string; pg_cron stuurt hem mee naar /api/cron/tick
SLIDE_SIGNING_SECRET=              # lange willekeurige string; tekent publieke slide-URL's voor Instagram

# Supabase (apart project voor Mission Control)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # alleen server: agents en dispatcher

# Claude API (console.anthropic.com, los van een Claude Pro-abonnement)
ANTHROPIC_API_KEY=
CLAUDE_MODEL_WRITE=claude-opus-5-5   # schrijven: posts, carrousels, scripts
CLAUDE_MODEL_SCAN=claude-haiku-5-5   # scannen en sorteren (Scout, Chief)

# LinkedIn — kies één route
LINKEDIN_ROUTE=buffer              # buffer | share_api
BUFFER_ACCESS_TOKEN=
BUFFER_LINKEDIN_CHANNEL_ID=
LINKEDIN_ACCESS_TOKEN=             # alleen bij share_api (scope w_member_social)
LINKEDIN_PERSON_URN=               # urn:li:person:xxxx
LINKEDIN_API_VERSION=202511

# Instagram Graph API (Business- of Creator-account gekoppeld aan een Facebook-pagina)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0

# Website marketbooster.nl (Lovable-project "Marketbooster", eigen Supabase) — voor Ranker
SITE_SUPABASE_URL=                 # https://<project-ref>.supabase.co van de website
SITE_SUPABASE_ANON_KEY=            # publieke anon key van de website (bestaande blogs lezen)
SITE_BLOG_SECRET=                  # = MAKE_WEBHOOK_SECRET van de website (create-blog-draft)
SITE_SUPABASE_SERVICE_ROLE_KEY=    # optioneel: dan zet Publiceer de blog direct live i.p.v. als concept

# ContentFlow server-side configuratie. Kopieer naar .env (wordt NOOIT naar de frontend gestuurd).
# Let op: een ChatGPT Plus- of Claude Pro-abonnement geeft GEEN API-toegang of API-tegoed.
# Maak aparte API-sleutels aan via console.anthropic.com en platform.openai.com.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

OPENAI_API_KEY=
# Vul het OpenAI-model in dat je wilt gebruiken (zie platform.openai.com/docs/models).
OPENAI_MODEL=
# Prijzen per 1 miljoen tokens in USD, voor kostenregistratie. Controleer op openai.com/api/pricing.
OPENAI_INPUT_USD_PER_MTOK=
OPENAI_OUTPUT_USD_PER_MTOK=

# Kostenbeheersing
AI_MONTHLY_BUDGET_USD=25
AI_COUNCIL_MONTHLY_LIMIT=40
AI_REQUESTS_PER_MINUTE=10
AI_TIMEOUT_MS=120000
PORT=8787

# Online (NODE_ENV=production): verplicht wachtwoord van minimaal 12 tekens voor de hele app.
APP_PASSWORD=
# Map voor kostenregistratie en AI-jobs. Online: het pad van een blijvend volume, bv. /data
DATA_DIR=data

# Inbox voor geplande taken (Metapic, HEMA, low kcal, voorraad, samenwerkingen).
# Minimaal 24 tekens. Alleen voor het AFLEVEREN van tips; lezen kan alleen in de app.
INBOX_TOKEN=
